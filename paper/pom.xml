<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.prankcraft</groupId>
    <artifactId>prankcraft-parent</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>prankcraft-plugin</artifactId>
  <packaging>jar</packaging>
  <name>PrankCraft Paper plugin</name>

  <dependencies>
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>${paper.api.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.prankcraft</groupId>
      <artifactId>prankcraft-core</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>PrankCraft-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <!--
                The core module holds every class; this module exists so that the *paper*
                platform has a place to grow (packet adapters, Folia schedulers, ...) without
                dragging Forge into it. Shading is used purely to fold the two jars into one,
                so nothing is relocated and nothing is minimised: the only dependency pulled
                in is our own core module.
              -->
              <minimizeJar>false</minimizeJar>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>com.prankcraft:prankcraft-core</include>
                </includes>
                <excludes>
                  <!-- Provided by the server at runtime; never bundle an API into a plugin. -->
                  <exclude>io.papermc.paper:*</exclude>
                  <exclude>org.spigotmc:*</exclude>
                  <exclude>org.bukkit:*</exclude>
                </excludes>
              </artifactSet>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Implementation-Title>PrankCraft</Implementation-Title>
                    <Implementation-Version>${project.version}</Implementation-Version>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
